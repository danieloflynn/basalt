{
  "comment": "Type-checks the Electron main + preload. esbuild does the actual transpile (build.mjs); this config is noEmit and exists so `tsc -p electron` catches type errors in the privileged code the renderer's build never sees.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [
    "main.ts",
    "preload.ts",
    "ipc.ts",
    "git/**/*.ts",
    "services/**/*.ts",
    "../src/engine/types.ts",
    "../src/engine/bridge.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
